{
    // ══════════════════════════════════════════════════════════════
    // 任务系统隔离（重要）
    // ══════════════════════════════════════════════════════════════
    // 关闭扩展的任务自动探测。CMake Tools 会自行注册一批 "CMake: xxx" 构建任务，
    // 与 tasks.json 里同名前缀的任务争抢 Ctrl+Shift+B；一旦命中扩展那份，
    // 而扩展又尚未完成初始化，就会报出与构建无关的错误。
    // 关掉之后，Ctrl+Shift+B 只可能命中 tasks.json 中的 "CMake: Build (MinGW)"。
    // 构建完全由 scripts\build-mingw.cmd 承担，不依赖任何扩展。
    "task.autoDetect": "off",

    // ══════════════════════════════════════════════════════════════
    // CMake Tools：仅用于 IntelliSense 与状态栏，不参与 Ctrl+Shift+B
    // ══════════════════════════════════════════════════════════════
    "cmake.useCMakePresets": "always",
    "cmake.configurePreset": "mingw",
    "cmake.buildPreset": "mingw",
    "cmake.configureOnOpen": true,
    // 编辑 CMakeLists.txt 不自动重新配置：本项目 57 个 target，
    // generate 阶段要 20 多秒，改成手动跑 "CMake: Configure (MinGW)" 任务
    "cmake.configureOnEdit": false,
    "cmake.buildBeforeDebug": true,
    "cmake.parallelJobs": 0,

    // 只在 CMake Tools 派生的进程里把 MinGW 顶到 PATH 最前，
    // 不写系统环境变量，避免与机器上其它 gcc（MSYS2 / Cygwin / Git）互相干扰
    "cmake.environment": {
        "PATH": "D:\\mingw64\\bin;${env:PATH}"
    },
    "cmake.additionalCompilerSearchDirs": [
        "D:\\mingw64\\bin"
    ],

    // CMake Tools 自带的"调试当前 target"（状态栏小虫子图标）也用 MinGW gdb
    "cmake.debugConfig": {
        "MIMode": "gdb",
        "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
        "cwd": "${workspaceFolder}",
        "externalConsole": false,
        "console": "integratedTerminal",
        "environment": [
            {
                "name": "PATH",
                "value": "D:\\mingw64\\bin;${env:PATH}"
            }
        ],
        "setupCommands": [
            {
                "description": "启用 gdb 结构体美化输出",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    },

    // ══════════════════════════════════════════════════════════════
    // 集成终端：手动敲 gcc / gdb / mingw32-make 时同样命中 D:\mingw64
    // （仅对本工作区的终端生效）
    // ══════════════════════════════════════════════════════════════
    "terminal.integrated.env.windows": {
        "PATH": "D:\\mingw64\\bin;${env:PATH}"
    },

    // ══════════════════════════════════════════════════════════════
    // C/C++ 编辑体验
    // ══════════════════════════════════════════════════════════════
    "files.associations": {
        "*.h": "c"
    },
    "files.encoding": "utf8",
    "C_Cpp.default.cStandard": "c99",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.errorSquiggles": "enabled",
    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },

    // 构建产物不参与搜索 / 文件树，避免 out/ 下上千个中间文件干扰
    "files.exclude": {
        "**/out/build/**/CMakeFiles": true
    },
    "search.exclude": {
        "out/": true
    },
    "files.watcherExclude": {
        "**/out/**": true
    }
}
